# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Message Delivery (configure ONE of the following):
# 1. Telegram Bot (instant delivery to your Telegram, no domain or SMTP needed)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 2. Web3Forms (email delivery, no custom domain needed: https://web3forms.com)
WEB3FORMS_ACCESS_KEY=""

# 3. Brevo Transactional Email (free 300/day, works with verified personal Gmail: https://brevo.com)
BREVO_API_KEY=""

# 4. Gmail SMTP via App Password (sends directly from your Gmail account)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional override for the secret message email recipient (defaults to akramjonabduhakimov1@gmail.com)
SECRET_MESSAGE_RECIPIENT_EMAIL="akramjonabduhakimov1@gmail.com"
